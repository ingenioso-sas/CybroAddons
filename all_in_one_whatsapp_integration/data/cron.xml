<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_whatsapp_queue_process" model="ir.cron">
        <field name="name">Procesar Cola de WhatsApp</field>
        <field name="model_id" ref="model_whatsapp_queue_message"/>
        <field name="state">code</field>
        <field name="code">model._process_queue()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_whatsapp_message_process" model="ir.cron">
        <field name="name">Procesar Mensajes WhatsApp (Cloud API)</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="state">code</field>
        <field name="code">model.process_whatsapp_queue()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
