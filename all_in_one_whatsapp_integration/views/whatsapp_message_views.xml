 <odoo>
     <data>
         <record id="whatsapp_message_action" model="ir.actions.act_window">
             <field name="name">WhatsApp Messages</field>
             <field name="res_model">whatsapp.message</field>
             <field name="view_mode">tree,form</field>
             <field name="help" type="html">
                 <p class="o_view_nocontent_smiling_face">
                     No WhatsApp messages in the queue!
                 </p>
             </field>
         </record>

         <record model="ir.ui.view" id="whatsapp_message_tree_view">
             <field name="name">whatsapp.message.tree</field>
             <field name="model">whatsapp.message</field>
             <field name="arch" type="xml">
                 <tree>
                     <field name="number"/>
                     <field name="message"/>
                     <field name="status"/>
                 </tree>
             </field>
         </record>

         <record model="ir.ui.view" id="whatsapp_message_form_view">
             <field name="name">whatsapp.message.form</field>
             <field name="model">whatsapp.message</field>
             <field name="arch" type="xml">
                 <form>
                     <sheet>
                         <group>
                             <field name="number"/>
                             <field name="status"/>
                         </group>
                         <group>
                             <field name="message"/>
                         </group>
                         <notebook>
                             <page string="Attachments">
                                 <field name="attachment_ids" widget="many2many_binary"/>
                             </page>
                         </notebook>
                     </sheet>
                 </form>
             </field>
         </record>

         <record model="ir.ui.menu" id="whatsapp_messages_menu">
             <field name="name">WhatsApp Messages</field>
             <field name="parent_id" ref="base.menu_administration"/>
             <field name="action" ref="whatsapp_message_action"/>
             <field name="sequence">20</field>
         </record>

         <record model="ir.ui.menu" id="whatsapp_messages_technical_menu">
             <field name="name">WhatsApp Messages</field>
             <field name="parent_id" ref="base.menu_email"/>
             <field name="action" ref="whatsapp_message_action"/>
             <field name="sequence">20</field>
         </record>
     </data>
 </odoo>
