<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_provider_tree" model="ir.ui.view">
        <field name="name">whatsapp.provider.tree</field>
        <field name="model">whatsapp.provider</field>
        <field name="arch" type="xml">
            <list string="Proveedores WhatsApp" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_test_state" widget="badge"/>
                <field name="last_test_date"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_provider_form" model="ir.ui.view">
        <field name="name">whatsapp.provider.form</field>
        <field name="model">whatsapp.provider</field>
        <field name="arch" type="xml">
            <form string="Proveedor WhatsApp">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_toggle"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="code" readonly="id"
                               help="Canal de envío. No se puede cambiar una vez creado."/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Credenciales" name="credentials"
                              groups="all_in_one_whatsapp_integration.group_whatsapp_manager">
                            <div class="alert alert-info" role="alert">
                                Los campos vacíos usan las credenciales globales
                                de Ajustes → WhatsApp. Los valores efectivos que
                                se usarán se muestran al final.
                            </div>
                            <div class="mb-2">
                                <button name="action_copy_global_credentials"
                                        type="object"
                                        string="Copiar credenciales globales"
                                        class="btn-secondary"/>
                                <button name="action_use_global_credentials"
                                        type="object"
                                        string="Usar credenciales globales"
                                        class="btn-link"/>
                            </div>
                            <group string="Cloud API (Meta)">
                                <field name="cloud_graph_version"/>
                                <field name="cloud_phone_number_id"/>
                                <field name="cloud_bearer_token" password="True"/>
                            </group>
                            <group string="Evolution API">
                                <field name="evolution_base_url"/>
                                <field name="evolution_instance"/>
                                <field name="evolution_apikey" password="True"/>
                            </group>
                            <group string="Twilio">
                                <field name="twilio_account_sid"/>
                                <field name="twilio_auth_token" password="True"/>
                                <field name="twilio_whatsapp_number"/>
                            </group>
                            <group string="Valores efectivos (solo lectura)">
                                <group string="Evolution API">
                                    <field name="evolution_credential_source" widget="badge"/>
                                    <field name="effective_evolution_base_url" readonly="1"/>
                                    <field name="effective_evolution_instance" readonly="1"/>
                                    <field name="effective_evolution_apikey" readonly="1"/>
                                </group>
                                <group string="Cloud API (Meta)">
                                    <field name="cloud_credential_source" widget="badge"/>
                                    <field name="effective_cloud_phone_number_id" readonly="1"/>
                                    <field name="effective_cloud_graph_version" readonly="1"/>
                                    <field name="effective_cloud_bearer_token" readonly="1"/>
                                </group>
                                <group string="Twilio">
                                    <field name="twilio_credential_source" widget="badge"/>
                                    <field name="effective_twilio_account_sid" readonly="1"/>
                                    <field name="effective_twilio_whatsapp_number" readonly="1"/>
                                    <field name="effective_twilio_auth_token" readonly="1"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                «Copiar credenciales globales» guarda los valores
                                globales en este proveedor. «Usar credenciales
                                globales» vacía los campos para volver al
                                fallback de Ajustes → WhatsApp.
                            </div>
                        </page>
                    </notebook>
                    <group string="Última prueba de conexión">
                        <field name="last_test_state"/>
                        <field name="last_test_date"/>
                        <field name="last_test_info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_provider" model="ir.actions.act_window">
        <field name="name">Proveedores WhatsApp</field>
        <field name="res_model">whatsapp.provider</field>
        <field name="view_mode">list,form</field>
        <!-- Mostrar también los deshabilitados para poder activarlos -->
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
