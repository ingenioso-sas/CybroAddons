<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">Operador</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="comment">Puede enviar mensajes y gestionar la cola de WhatsApp.</field>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="comment">Configura proveedores, credenciales y la cola de WhatsApp.</field>
    </record>

    <!-- Los administradores del sistema conservan acceso al módulo. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>

    <record id="rule_whatsapp_queue_company" model="ir.rule">
        <field name="name">Cola WhatsApp: regla multi-compañía</field>
        <field name="model_id" ref="model_whatsapp_queue_message"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user')), (4, ref('group_whatsapp_manager'))]"/>
    </record>

    <record id="rule_whatsapp_provider_company" model="ir.rule">
        <field name="name">Proveedor WhatsApp: regla multi-compañía</field>
        <field name="model_id" ref="model_whatsapp_provider"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user')), (4, ref('group_whatsapp_manager'))]"/>
    </record>
</odoo>
