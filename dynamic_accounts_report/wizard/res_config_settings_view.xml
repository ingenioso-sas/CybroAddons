<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dynamic.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>Auditoría Contable (Estático / IA)</h2>
                <div class="row mt16 o_settings_container">
                    <!-- Enable/Disable Controls -->
                    <div class="col-12 col-lg-6 o_setting_box" id="enable_static_audit_config">
                        <div class="o_setting_left_pane">
                            <field name="enable_static_audit"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Habilitar Análisis Estático</span>
                            <div class="text-muted">
                                Permitir a los usuarios realizar auditorías estáticas basadas en reglas contables.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="enable_ai_audit_config">
                        <div class="o_setting_left_pane">
                            <field name="enable_ai_audit"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Habilitar Análisis con IA</span>
                            <div class="text-muted">
                                Permitir a los usuarios solicitar diagnósticos generados por Inteligencia Artificial.
                            </div>
                        </div>
                    </div>
                </div>

                <h2 attrs="{'invisible': [('enable_ai_audit', '=', False)]}">Configuración del Servidor de IA</h2>
                <div class="row mt16 o_settings_container" attrs="{'invisible': [('enable_ai_audit', '=', False)]}">
                    <div class="col-12 col-lg-6 o_setting_box" id="lm_studio_url_config">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">URL base de la IA</span>
                            <div class="text-muted">
                                URL base del servidor de IA (ej: http://localhost:1234/v1)
                            </div>
                            <div class="content-group">
                                <field name="lm_studio_api_url" placeholder="http://localhost:1234/v1" attrs="{'required': [('enable_ai_audit', '=', True)]}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="lm_studio_key_config">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Token o API Key</span>
                            <div class="text-muted">
                                Clave para autenticarse con el servidor de IA
                            </div>
                            <div class="content-group">
                                <field name="lm_studio_api_key" password="True" attrs="{'required': [('enable_ai_audit', '=', True)]}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="lm_studio_model_config">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Nombre del Modelo</span>
                            <div class="text-muted">
                                Identificador del modelo cargado en el servidor de IA
                            </div>
                            <div class="content-group">
                                <field name="lm_studio_model" placeholder="mistralai/ministral-3-3b" attrs="{'required': [('enable_ai_audit', '=', True)]}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
