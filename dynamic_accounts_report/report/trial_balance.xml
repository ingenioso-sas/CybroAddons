<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Report Template for trial balance-->
    <template id="trial_balance">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h3>
                        <center>
                            <b>
                                <span t-esc="report_name"/>
                            </b>
                        </center>
                    </h3>
                    <br/>
                    <br/>
                    <div class="filters">
                        <table class="table table-sm table-reports">
                            <thead class="filter_table"
                                   style="background:#808080;">
                                <tr>
                                    <th>Date Range</th>
                                    <th>Comparison</th>
                                    <th>Account</th>
                                    <th>Journal</th>
                                    <th>Options</th>
                                    <th>Display Accounts</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:11px;font-weight:100;">
                                <tr>
                                    <th>
                                        <t t-if="filters['start_date']"
                                           t-out="filters['start_date']"/>
                                        <t t-if="filters['end_date']">
                                            to
                                            <t t-out="filters['end_date']"/>
                                        </t>
                                    </th>
                                    <th>
                                        <t t-if="filters['comparison_number_range']">
                                            <t t-out="filters['comparison_type']"/>
                                            :
                                            <t t-out="filters['comparison_number_range']"/>
                                        </t>
                                    </th>
                                    <th>
                                        <t t-foreach="filters['journal']"
                                           t-as="selected_journal"
                                           t-key="journal_index">
                                            <t t-out="selected_journal"/>
                                            ,
                                        </t>
                                    </th>
                                    <th>
                                        <t t-foreach="filters['account']"
                                           t-as="selected_account"
                                           t-key="account_index">
                                            <t t-out="selected_account['display_name']"/>
                                            ,
                                        </t>
                                    </th>
                                    <th>
                                        <t t-foreach="filters['options']"
                                           t-as="selected_options"
                                           t-key="options_index">
                                            <t t-out="selected_options"/>,
                                        </t>
                                    </th>
                                    <th>
                                        <t t-if="filters.get('display_account') == 'all'">
                                            All Accounts
                                        </t>
                                        <t t-elif="filters.get('display_account') == 'not_zero'">
                                            Non-zero Balance
                                        </t>
                                        <t t-else="">
                                            With Movements
                                        </t>
                                    </th>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:11px;font-weight:100;">
                        <strong>PUC Level:</strong>
                        <t t-esc="filters.get('puc_level') or '0'"/>
                        <strong>Range:</strong>
                        <t t-esc="filters.get('account_from_code') or '...'"/> to
                        <t t-esc="filters.get('account_to_code') or '...'"/>
                        <strong>Analytic:</strong>
                        <t t-esc="filters.get('analytics_label') or 'All'"/>
                        (<t t-esc="filters.get('analytic_filter_label') or 'All lines'"/>)
                    </div>
                    <br/>
                    <br/>
                    <br/>
                    <t t-if="not period_columns">
                        <t t-set="period_columns"
                           t-value="[{'label': (date_viewed or [''])[-1], 'debitKey': 'total_debit', 'creditKey': 'total_credit'}]"/>
                    </t>
                    <table class="table table-sm table-reports"
                           style="width: fit-content;">
                        <thead style="background:#808080;">
                            <tr>
                                <th colspan="6">Account</th>
                                <th>Initial Balance</th>
                                <t t-foreach="period_columns" t-as="period"
                                   t-key="period_index">
                                    <th colspan="2">
                                        <t t-esc="period['label']"/>
                                    </th>
                                </t>
                                <th colspan="2">End Balance</th>
                            </tr>
                            <tr class="o_heading"
                                style="text-align:center;background:#D3D3D3;">
                                <th colspan="6"/>
                                <th>Amount</th>
                                <t t-foreach="period_columns" t-as="period"
                                   t-key="period_index">
                                    <th>Debit</th>
                                    <th>Credit</th>
                                </t>
                                <th>Debit</th>
                                <th>Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="data">
                                <t t-foreach="data[0]" t-as="move_line"
                                   t-key="move_line_index">
                                    <tr class="border-bottom"
                                        style="border-spacing: 0 10px;">
                                        <th colspan="6">
                                            <t t-esc="move_line['account']"/>
                                        </th>
                                        <th style="text-align:center;">
                                            <t t-esc="move_line.get('initial', 0.0)"/>
                                        </th>
                                        <t t-foreach="period_columns" t-as="period"
                                           t-key="period_index">
                                            <th style="text-align:center;">
                                                <t t-esc="move_line.get(period['debitKey'], 0.0)"/>
                                            </th>
                                            <th style="text-align:center;">
                                                <t t-esc="move_line.get(period['creditKey'], 0.0)"/>
                                            </th>
                                        </t>
                                        <th style="text-align:center;">
                                            <t t-esc="move_line.get('final_debit', 0.0)"/>
                                        </th>
                                        <th style="text-align:center;">
                                            <t t-esc="move_line.get('final_credit', 0.0)"/>
                                        </th>
                                    </tr>
                                </t>
                                <t t-if="totals">
                                    <tr class="border-bottom"
                                        style="border-spacing: 0 10px;">
                                        <th colspan="6">Total</th>
                                        <th style="text-align:center;">
                                            <t t-esc="totals.get('initial', 0.0)"/>
                                        </th>
                                        <t t-foreach="period_columns" t-as="period"
                                           t-key="period_index">
                                            <th style="text-align:center;">
                                                <t t-esc="totals.get(period['debitKey'], 0.0)"/>
                                            </th>
                                            <th style="text-align:center;">
                                                <t t-esc="totals.get(period['creditKey'], 0.0)"/>
                                            </th>
                                        </t>
                                        <th style="text-align:center;">
                                            <t t-esc="totals.get('final_debit', 0.0)"/>
                                        </th>
                                        <th style="text-align:center;">
                                            <t t-esc="totals.get('final_credit', 0.0)"/>
                                        </th>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>