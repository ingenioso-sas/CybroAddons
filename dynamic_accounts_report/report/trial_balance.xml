<odoo>



    <template id="dynamic_accounts_report.trial_balance">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <h3 style="text-align:centre;left:50%;"><span t-esc="Filters.get('company_name')"/>: Balance de Comprobación
                    </h3>

                    <span t-if="Filters.get('date_from')">
                    <strong> Desde:</strong>
                    <t t-esc="Filters['date_from']"/>
                    </span>



                    <span t-if="Filters.get('date_to')">
                    <strong>Hasta:</strong>
                    <t t-esc="Filters['date_to']"/>
                    </span>
                    <span>
                    <strong>Nivel PUC:</strong>
                    <t t-esc="Filters.get('puc_level_label') or ''"/>
                    <strong>Rango:</strong>
                    <t t-esc="Filters.get('account_from_code') or '...'"/> a
                    <t t-esc="Filters.get('account_to_code') or '...'"/>
                    </span>


                    <div>
                        <div style="text-align:centre;left:50%;" class="row">

                                <div class="col-3" style="">
                                    <strong>Journals:</strong>
                                    <t t-foreach="Filters['journals']" t-as="ps">
                                        <li>
                                            <t t-esc="ps"/>
                                        </li>
                                    </t>
                                </div>

                                <div class="col-3">
                                    <strong>Target move:</strong>
                                        <li>
                                            <t t-esc="Filters['target_move']"/>
                                        </li>
                                </div>
                        </div>


                        <br></br>
                        <table class="table table-sm table-reports">
                            <thead>
                                <tr>
                                    <th style="text-align:left;">Código</th>
                                    <th colspan="5">Cuenta (PUC/NIIF)</th>
                                    <th class="mon_fld">Saldo Anterior</th>
                                    <th class="text-right">Débito</th>
                                    <th class="text-right">Crédito</th>
                                    <th class="text-right">Saldo Final Deudor</th>
                                    <th class="text-right">Saldo Final Acreedor</th>
                                </tr>
                            </thead>
                            <t t-foreach="account_data" t-as="line">

                                    <tr>

                                        <td style="text-align:left;">
                                            <span style="color: white;" t-esc="'..'"/>
                                            <span t-esc="line['code']"/>
                                        </td>
                                        <td colspan="5">
                                            <span style="color: white;" t-esc="'..'"/>
                                            <span t-esc="line['name']"/>
                                        </td>
                                        <td class="mon_fld">
                                            <t t-esc="line.get('initial', 0.0)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>

                                        <td class="text-right">
                                            <span t-esc="line['debit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line['credit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.get('final_debit', 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.get('final_credit', 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                            </t>
                            <td colspan="6" style="border-bottom: 1px solid ;" class="mon_fld"><strong>TOTALES</strong></td>
                            <td class="mon_fld" style="border-bottom: 1px solid ;"><strong><t t-esc="Filters.get('initial_total', 0.0)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>

							<td class="text-right" style="border-bottom: 1px solid ;"><strong><t t-esc="debit_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>
							<td class="text-right" style="border-bottom: 1px solid;"><strong><t t-esc="credit_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>
							<td class="text-right" style="border-bottom: 1px solid;"><strong><t t-esc="Filters.get('final_debit_total', 0.0)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>
							<td class="text-right" style="border-bottom: 1px solid;"><strong><t t-esc="Filters.get('final_credit_total', 0.0)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>

                        </table>
                    </div>
                    <br></br>
                </div>
            </t>
        </t>
    </template>

    <record id="action_print_trial_balance" model="ir.actions.report">
            <field name="name">Trial Balance</field>
            <field name="model">account.trial.balance</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dynamic_accounts_report.trial_balance</field>
            <field name="report_file">dynamic_accounts_report.trial_balance</field>
    </record>

</odoo>