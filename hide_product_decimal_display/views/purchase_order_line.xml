<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="purchase_order_line_clean_qty_display" model="ir.ui.view">
    <field name="name">purchase.order.form.clean.qty</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <!-- Árbol de líneas -->
      <xpath expr="//field[@name='order_line']/tree//field[@name='product_qty']" position="attributes">
        <attribute name="widget">float</attribute>
        <attribute name="digits" delete="1"/>
      </xpath>
      <!-- Formulario de líneas -->
      <xpath expr="//field[@name='order_line']/form//field[@name='product_qty']" position="attributes">
        <attribute name="widget">float</attribute>
        <attribute name="digits" delete="1"/>
      </xpath>
    </field>
  </record>
</odoo>