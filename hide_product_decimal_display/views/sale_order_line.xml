<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
         <record model="ir.ui.view" id="sale_order_line_hide_decimal_quantity">
            <field name="name">sale.order.line.form.hide_decimal_quantity</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="attributes">
                    <attribute name="widget">float</attribute>
                    <attribute name="digits" delete="1"/>
                    </xpath>
                    <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="attributes">
                    <attribute name="widget">float</attribute>
                    <attribute name="digits" delete="1"/>
                    </xpath>          
            </field>
        </record>     
    </data>
</odoo>   